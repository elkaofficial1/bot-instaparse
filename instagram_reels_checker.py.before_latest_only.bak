
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import argparse
import re
import sys
import time
from datetime import datetime, date
from pathlib import Path
from urllib.parse import urlparse

import pandas as pd
from playwright.sync_api import sync_playwright, TimeoutError as PlaywrightTimeoutError


MAX_SCROLL_STEPS = 600
INSTAGRAM_URL_RE = re.compile(
    r"(?:https?://)?(?:www\.)?instagram\.com/([A-Za-z0-9._]+)/?"
    r"(?:\?[^\s]*)?",
    re.IGNORECASE,
)

USERNAME_RE = re.compile(r"^[A-Za-z0-9._]{1,30}$")


def log(message):
    print(message, flush=True)


def normalize_username(value):
    """Извлекает username из Instagram URL или @username."""
    if value is None:
        return None

    value = str(value).strip()

    if not value or value.lower() in ("nan", "none"):
        return None

    value = value.strip(" \t\r\n,;\"'()[]{}<>")

    if value.startswith("@"):
        value = value[1:]

    match = INSTAGRAM_URL_RE.search(value)

    if match:
        username = match.group(1)
    else:
        username = value.split("/")[0].split("?")[0].strip()

    if USERNAME_RE.fullmatch(username):
        return username.lower()

    return None


def extract_usernames_from_text(text):
    """Ищет Instagram-профили в произвольном тексте."""
    if text is None:
        return []

    text = str(text)
    found = []

    for match in INSTAGRAM_URL_RE.finditer(text):
        username = normalize_username(match.group(0))
        if username:
            found.append(username)

    # Отдельно поддерживаем записи вида @username.
    for match in re.finditer(r"(?<![\w.])@([A-Za-z0-9._]{1,30})", text):
        username = normalize_username(match.group(1))
        if username:
            found.append(username)

    return found


def read_input_file(path):
    """Автоматически определяет XLS, XLSX, CSV или HTML."""
    path = Path(path)

    if not path.exists():
        raise FileNotFoundError(f"Файл не найден: {path}")

    # Настоящий XLSX
    try:
        sheets = pd.read_excel(path, sheet_name=None, dtype=str, engine="openpyxl")
        return list(sheets.values())
    except Exception:
        pass

    # Настоящий XLS
    try:
        sheets = pd.read_excel(path, sheet_name=None, dtype=str, engine="xlrd")
        return list(sheets.values())
    except Exception:
        pass

    # HTML, даже если файл имеет расширение .xls
    try:
        frames = pd.read_html(path, keep_default_na=False)
        if frames:
            return frames
    except Exception:
        pass

    # CSV с разными разделителями и кодировками
    for encoding in ("utf-8-sig", "cp1251", "utf-8"):
        try:
            frame = pd.read_csv(
                path, dtype=str, encoding=encoding,
                sep=None, engine="python"
            )
            if not frame.empty:
                return [frame]
        except Exception:
            pass

    raise ValueError(f"Не удалось определить формат файла: {path}")


def extract_accounts(path):
    """Извлекает уникальные Instagram-аккаунты из входного файла."""
    frames = read_input_file(path)

    accounts = []
    seen = set()

    for frame in frames:
        for value in frame.astype(str).values.flatten():
            for username in extract_usernames_from_text(value):
                if username not in seen:
                    seen.add(username)
                    accounts.append(username)

    return accounts



def collect_reel_links(page, username):
    """
    Собирает все доступные ссылки Reels со страницы /username/reels/.
    Прокручивает страницу до подтверждённого конца списка.
    """
    profile_url = f"https://www.instagram.com/{username}/reels/"
    page.goto(profile_url, wait_until="domcontentloaded", timeout=60000)
    page.wait_for_timeout(2500)

    try:
        page.wait_for_selector('a[href*="/reel/"]', timeout=20000)
    except PlaywrightTimeoutError:
        log("  Не появилась сетка Reels.")
        return [], False

    links = []
    seen = set()
    no_growth = 0
    previous_height = 0
    reached_end = False

    for step in range(MAX_SCROLL_STEPS):
        try:
            hrefs = page.locator('a[href*="/reel/"]').evaluate_all(
                "(els) => els.map(el => el.href)"
            )
        except Exception:
            hrefs = []

        old_count = len(links)

        for href in hrefs:
            try:
                parsed = urlparse(href)
                parts = [x for x in parsed.path.split("/") if x]

                try:
                    reel_index = next(
                        i for i, part in enumerate(parts)
                        if part in ("reel", "reels")
                    )
                    shortcode = parts[reel_index + 1]
                except (StopIteration, IndexError):
                    continue

                canonical = (
                    f"https://www.instagram.com/reel/{shortcode}/"
                )

                if canonical not in seen:
                    seen.add(canonical)
                    links.append(canonical)

            except Exception:
                continue

        if len(links) == old_count:
            no_growth += 1
        else:
            no_growth = 0
            log(f"  Собрано Reels: {len(links)}")

        try:
            height = page.evaluate(
                "() => Math.max(document.body.scrollHeight, "
                "document.documentElement.scrollHeight)"
            )

            page.evaluate(
                "() => window.scrollTo(0, "
                "Math.max(document.body.scrollHeight, "
                "document.documentElement.scrollHeight))"
            )
        except Exception:
            height = previous_height

        if no_growth >= 8 and height == previous_height:
            reached_end = True
            break

        previous_height = height
        page.wait_for_timeout(1500)

    if not reached_end:
        log("  Внимание: конец списка Reels не подтверждён.")

    log(f"  Всего собрано ссылок: {len(links)}")
    return links, reached_end


def parse_datetime(value):
    """Преобразует дату из HTML в datetime."""
    if not value:
        return None

    try:
        result = pd.to_datetime(value, utc=True, errors="coerce")

        if pd.isna(result):
            return None

        return result.to_pydatetime().replace(tzinfo=None)

    except Exception:
        return None


def read_reel_date(page, url):
    """Открывает Reel и пытается получить дату публикации."""
    try:
        page.goto(
            url,
            wait_until="domcontentloaded",
            timeout=60000
        )

        page.wait_for_timeout(1000)

        # Основной способ: datetime у элемента time.
        time_elements = page.locator("time[datetime]")

        if time_elements.count() > 0:
            value = time_elements.first.get_attribute("datetime")
            result = parse_datetime(value)

            if result:
                return result

        # Дополнительные варианты через meta.
        selectors = [
            'meta[property="article:published_time"]',
            'meta[property="og:published_time"]',
            'meta[name="date"]',
            'meta[name="publish_date"]',
        ]

        for selector in selectors:
            element = page.locator(selector)

            if element.count() > 0:
                value = element.first.get_attribute("content")
                result = parse_datetime(value)

                if result:
                    return result

        # Иногда дата присутствует в JSON-LD.
        json_ld = page.locator('script[type="application/ld+json"]')

        for index in range(json_ld.count()):
            try:
                content = json_ld.nth(index).inner_text()

                match = re.search(
                    r'"(?:uploadDate|datePublished)"\s*:\s*"([^"]+)"',
                    content
                )

                if match:
                    result = parse_datetime(match.group(1))

                    if result:
                        return result

            except Exception:
                continue

        return None

    except Exception as error:
        log(f"    Ошибка открытия Reel: {error}")
        return None



def check_account(page, username, max_age_days):
    """Проверяет даты всех доступных Reels аккаунта."""
    log(f"\nПроверяю @{username}")

    try:
        reel_urls, reached_end = collect_reel_links(page, username)
    except Exception as error:
        log(f"  Ошибка профиля: {error}")
        return {
            "username": username, "status": "unknown",
            "date": None, "age_days": None, "reel_url": None,
            "checked": 0, "total": 0, "reason": str(error),
        }

    if not reel_urls:
        log("  Reels не найдены или Instagram не показал список.")
        return {
            "username": username, "status": "unknown",
            "date": None, "age_days": None, "reel_url": None,
            "checked": 0, "total": 0,
            "reason": "Не удалось получить ссылки на Reels",
        }

    log(f"  Начинаю проверку дат: {len(reel_urls)} Reels")

    checked = 0
    failed = False
    today = date.today()
    latest_date = None
    latest_url = None
    latest_age = None

    for index, reel_url in enumerate(reel_urls, start=1):
        log(f"  Reel {index}/{len(reel_urls)}")

        reel_date = read_reel_date(page, reel_url)
        checked += 1

        if reel_date is None:
            log("    Дата не определена.")
            failed = True
            continue

        age_days = (today - reel_date.date()).days
        log(f"    Дата: {reel_date.date()} (возраст: {age_days} дней)")

        if age_days < -1:
            log("    Дата в будущем. Не учитываю.")
            failed = True
            continue

        if latest_date is None or reel_date > latest_date:
            latest_date = reel_date
            latest_url = reel_url
            latest_age = age_days

        # Не прекращаем проверку: обрабатываем каждый собранный Reel.
        time.sleep(0.3)

    # Если хотя бы одна публикация свежая, аккаунт точно KEEP.
    if latest_age is not None and latest_age <= max_age_days:
        log(f"  Последний Reel свежий ({latest_age} дней). KEEP.")
        return {
            "username": username, "status": "keep",
            "date": latest_date.date(), "age_days": latest_age,
            "reel_url": latest_url, "checked": checked,
            "total": len(reel_urls),
            "reason": "Найдена свежая публикация",
        }

    if failed:
        log("  Не все даты удалось прочитать. UNKNOWN.")
        status = "unknown"
        reason = "Не удалось прочитать даты всех Reels"
    elif not reached_end:
        log("  Конец списка не подтверждён. UNKNOWN.")
        status = "unknown"
        reason = "Не подтверждено, что проверены все Reels"
    else:
        log("  Все Reels старше заданного срока. EXCLUDE.")
        status = "exclude"
        reason = "Все доступные Reels старше заданного срока"

    return {
        "username": username, "status": status,
        "date": latest_date.date() if latest_date else None,
        "age_days": latest_age, "reel_url": latest_url,
        "checked": checked, "total": len(reel_urls),
        "reason": reason,
    }


def save_results(results, output_path):
    """Сохраняет результаты в Excel с тремя листами."""
    columns = [
        "username",
        "status",
        "date",
        "age_days",
        "reel_url",
        "checked",
        "total",
        "reason",
    ]

    all_df = pd.DataFrame(results, columns=columns)

    keep_df = all_df[all_df["status"] == "keep"].copy()
    exclude_df = all_df[all_df["status"] == "exclude"].copy()

    # Неизвестные результаты остаются в общем листе.
    # Они не попадают в исключения.
    with pd.ExcelWriter(output_path, engine="openpyxl") as writer:
        keep_df.to_excel(
            writer,
            sheet_name="Оставить",
            index=False
        )

        exclude_df.to_excel(
            writer,
            sheet_name="Исключить",
            index=False
        )

        all_df.to_excel(
            writer,
            sheet_name="Все проверки",
            index=False
        )

        for worksheet in writer.book.worksheets:
            worksheet.freeze_panes = "A2"
            worksheet.auto_filter.ref = worksheet.dimensions

            for column_cells in worksheet.columns:
                max_length = 0
                column_letter = column_cells[0].column_letter

                for cell in column_cells:
                    value = str(cell.value or "")
                    max_length = max(max_length, len(value))

                worksheet.column_dimensions[column_letter].width = min(
                    max_length + 2,
                    60
                )


def main():
    parser = argparse.ArgumentParser(
        description="Проверка дат последних Instagram Reels."
    )

    parser.add_argument(
        "input",
        help="Путь к XLS, XLSX, CSV или HTML файлу."
    )

    parser.add_argument(
        "--days",
        type=int,
        default=30,
        help="Максимальный возраст публикации в днях. По умолчанию 30."
    )

    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Ограничение количества аккаунтов для проверки."
    )

    parser.add_argument(
        "--output",
        default="instagram_checked.xlsx",
        help="Имя выходного Excel-файла."
    )

    args = parser.parse_args()

    if args.days < 0:
        parser.error("--days не может быть отрицательным.")

    try:
        accounts = extract_accounts(args.input)

    except Exception as error:
        log(f"Ошибка чтения входного файла: {error}")
        sys.exit(1)

    if not accounts:
        log("Instagram-аккаунты не найдены.")
        sys.exit(1)

    if args.limit is not None:
        accounts = accounts[:args.limit]

    log(f"Найдено аккаунтов: {len(accounts)}")
    log(f"Порог активности: {args.days} дней")
    log(f"Результат: {args.output}")

    results = []

    with sync_playwright() as playwright:
        context = playwright.chromium.launch_persistent_context(
            user_data_dir=str(Path.home() / ".instagram-reels-checker-profile"),
            headless=False,
            viewport={
                "width": 1440,
                "height": 1000
            },
            locale="ru-RU",
        )

        page = context.new_page()

        log("\nОткрываю Instagram.")
        page.goto(
            "https://www.instagram.com/",
            wait_until="domcontentloaded",
            timeout=60000
        )

        log(
            "\nЕсли нужно, войди в Instagram в открывшемся браузере."
        )
        input("После входа нажми Enter здесь... ")

        for index, username in enumerate(accounts, start=1):
            log(
                f"\n[{index}/{len(accounts)}] "
                f"Аккаунт @{username}"
            )

            result = check_account(
                page,
                username,
                args.days
            )

            results.append(result)

            log(
                f"  Итог: {result['status'].upper()} "
                f"| проверено: {result['checked']}"
            )

            # Небольшая пауза между аккаунтами.
            time.sleep(1)

        context.close()

    save_results(results, args.output)

    keep_count = sum(
        result["status"] == "keep" for result in results
    )

    exclude_count = sum(
        result["status"] == "exclude" for result in results
    )

    unknown_count = sum(
        result["status"] == "unknown" for result in results
    )

    log("\n" + "=" * 45)
    log("Проверка завершена.")
    log(f"Оставить:   {keep_count}")
    log(f"Исключить:  {exclude_count}")
    log(f"Неизвестно: {unknown_count}")
    log(f"Файл: {Path(args.output).resolve()}")
    log("=" * 45)


if __name__ == "__main__":
    main()
